# Server
PORT=5000
NODE_ENV=development
# Frontend origin(s) allowed by CORS. Comma-separate several. No trailing slash.
CLIENT_URL=http://localhost:3000

# Database (PostgreSQL)
# Local example. Change USER, PASSWORD and the database name to yours.
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/grocery
# Set to true for managed Postgres such as AWS RDS (turns on SSL)
DATABASE_SSL=false

# Auth
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Gemini (optional: the shop works without it)
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.8-flash

# Restock reminders
REMINDER_JOB=on
REMINDER_CRON=0 9 * * *
REMINDER_TZ=Asia/Kolkata
