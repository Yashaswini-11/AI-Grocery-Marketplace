# Server
PORT=5000
NODE_ENV=development
# Frontend origin(s) allowed by CORS. Comma-separate several. No trailing slash.
CLIENT_URL=http://localhost:3000

# Database (MongoDB Atlas). Keep the database name (/grocery) before the "?"
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/grocery?retryWrites=true&w=majority

# Auth
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Gemini (optional: the shop works without it)
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.8-flash

# Restock reminders
REMINDER_JOB=on
REMINDER_CRON=0 9 * * *
REMINDER_TZ=Asia/Kolkata

# Optional: public DNS if your network blocks mongodb+srv:// lookups
# DNS_SERVERS=8.8.8.8,1.1.1.1